<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Portal | KING OF THE 1/2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #0b0c0e; color: #f3f4f6; }
    .font-teko { font-family: 'Teko', sans-serif; text-transform: uppercase; }
  </style>
</head>
<body class="bg-[#0b0c0e] min-h-screen flex flex-col">

  <header class="bg-[#0e1014] border-b border-gray-800 py-4">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3">
        <div class="w-8 h-8 bg-amber-500 flex items-center justify-center font-teko font-bold text-black text-xl">K</div>
        <span class="font-teko text-2xl font-bold text-white tracking-wider">KING OF THE 1/2 ADMIN</span>
      </a>
      <a href="/" class="text-xs text-gray-400 hover:text-white transition">&larr; Return to Website</a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-10 w-full flex-1">
    
    <div class="mb-8">
      <h2 class="font-teko text-5xl font-bold text-white">RECORD SHOOTOUT MATCH</h2>
      <p class="text-xs text-gray-400">Transfers token from loser to winner and turns loser photo Black & White.</p>
    </div>

    <% if (error) { %>
      <div class="mb-6 p-4 bg-red-950/80 border border-red-800 rounded text-sm text-red-300">
        <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="mb-6 p-4 bg-emerald-950/80 border border-emerald-800 rounded text-sm text-emerald-300">
        <%= success %>
      </div>
    <% } %>

    <div class="bg-[#12141a] border border-gray-800 rounded-xl p-6 mb-10">
      <form action="/admin/record-match" method="POST" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <div class="bg-[#0b0c0e] border border-emerald-900 p-4 rounded">
            <label class="block text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2">Winner</label>
            <select name="winnerId" required class="w-full bg-[#12141a] border border-gray-800 rounded p-3 text-sm text-white">
              <option value="">-- Choose Winner --</option>
              <% users.forEach(u => { %>
                <option value="<%= u.id %>"><%= u.name %> (<%= u.id %>) [<%= u.group_class %>] - <%= u.tokens %> Tokens</option>
              <% }) %>
            </select>
          </div>

          <div class="bg-[#0b0c0e] border border-red-900 p-4 rounded">
            <label class="block text-xs font-bold uppercase tracking-wider text-red-400 mb-2">Loser (Eliminated)</label>
            <select name="loserId" required class="w-full bg-[#12141a] border border-gray-800 rounded p-3 text-sm text-white">
              <option value="">-- Choose Loser --</option>
              <% users.forEach(u => { %>
                <option value="<%= u.id %>"><%= u.name %> (<%= u.id %>) [<%= u.group_class %>] - <%= u.tokens %> Tokens</option>
              <% }) %>
            </select>
          </div>

        </div>

        <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-teko text-2xl font-bold py-3 rounded transition">
          EXECUTE MATCH & TRANSFER TOKENS
        </button>
      </form>
    </div>

    <!-- Match History -->
    <div class="bg-[#12141a] border border-gray-800 rounded-xl p-6">
      <h3 class="font-teko text-2xl font-bold text-white mb-4">MATCH LOGS</h3>
      <div class="space-y-2">
        <% matches.forEach(m => { %>
          <div class="bg-[#0b0c0e] p-3 rounded flex justify-between text-xs border border-gray-800">
            <div>
              <span class="font-bold text-emerald-400"><%= m.winner_name %></span>
              <span class="text-gray-500 px-1">defeated</span>
              <span class="font-bold text-red-400 line-through"><%= m.loser_name %></span>
            </div>
            <span class="text-amber-400 font-mono"><%= m.tokens_transferred %> Token(s)</span>
          </div>
        <% }) %>
      </div>
    </div>

  </main>

  <footer class="bg-[#0e1014] border-t border-gray-800 py-4 text-center text-xs text-gray-500">
    &copy; 2026 KING OF THE 1/2
  </footer>

</body>
</html>
