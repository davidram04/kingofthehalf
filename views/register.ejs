<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | KING OF THE 1/2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #0b0c0e; color: #f3f4f6; }
    .font-teko { font-family: 'Teko', sans-serif; text-transform: uppercase; }
  </style>
</head>
<body class="bg-[#0b0c0e] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="bg-[#0e1014] border-b border-gray-800 py-4">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3">
        <div class="w-8 h-8 bg-amber-500 flex items-center justify-center font-teko font-bold text-black text-xl">K</div>
        <span class="font-teko text-2xl font-bold text-white tracking-wider">KING OF THE 1/2</span>
      </a>
      <a href="/" class="text-xs text-gray-400 hover:text-white transition">&larr; Return to Home</a>
    </div>
  </header>

  <main class="flex-1 flex items-center justify-center p-4 py-12">
    <div class="bg-[#12141a] border border-gray-800 p-8 rounded-xl max-w-md w-full shadow-2xl">
      <div class="mb-6">
        <div class="text-amber-400 font-teko text-sm tracking-widest">CLAIM YOUR TOKEN</div>
        <h2 class="font-teko text-4xl font-bold text-white">RIDER REGISTRATION</h2>
      </div>

      <% if (error) { %>
        <div class="mb-6 p-3 bg-red-950/80 border border-red-800 rounded text-xs text-red-300">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1">Rider / Alias Name</label>
          <input type="text" name="name" required placeholder="e.g. GhostRider99" class="w-full bg-[#0b0c0e] border border-gray-800 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1">State (2 Letters)</label>
          <input type="text" name="state" maxlength="2" required placeholder="e.g. FL" class="w-full bg-[#0b0c0e] border border-gray-800 rounded px-4 py-3 text-sm uppercase text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1">Race Class</label>
          <select name="group_class" required class="w-full bg-[#0b0c0e] border border-gray-800 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            <option value="Stock Motor">Stock Motor</option>
            <option value="Stage 1 Motor">Stage 1 Motor</option>
            <option value="RWYB">RWYB (Run What Ya Brung)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1">Profile Photo (Color)</label>
          <input type="file" name="photo" accept="image/*" required class="w-full bg-[#0b0c0e] border border-gray-800 rounded px-3 py-2 text-xs text-gray-300">
          <p class="text-[10px] text-gray-500 mt-1">If you lose a race, your photo will automatically turn Black & White.</p>
        </div>

        <button type="submit" class="w-full bg-amber-400 hover:bg-amber-300 text-black font-teko text-2xl font-bold py-3 rounded transition mt-2">
          REGISTER & CLAIM 1 TOKEN
        </button>
      </form>
    </div>
  </main>

  <footer class="bg-[#0e1014] border-t border-gray-800 py-4 text-center text-xs text-gray-500">
    &copy; 2026 KING OF THE 1/2
  </footer>

</body>
</html>
